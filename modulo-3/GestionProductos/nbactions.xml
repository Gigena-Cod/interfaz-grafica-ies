<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings><packaging>jar</packaging></packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs></exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass} ${exec.appArgs}</exec.args>
            <exec.appArgs></exec.appArgs>
            <exec.mainClass>com.ies21.gestionproductos.GestionProductos</exec.mainClass>
            <exec.executable>${java.home}/bin/java</exec.executable>
            <exec.workingdir>${project.basedir}</exec.workingdir>
        </properties>
    </action>
    <action>
        <actionName>run.single.main</actionName>
        <packagings><packaging>jar</packaging></packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:exec</goal>
        </goals>
        <properties>
            <exec.vmArgs></exec.vmArgs>
            <exec.args>${exec.vmArgs} -classpath %classpath ${exec.mainClass} ${exec.appArgs}</exec.args>
            <exec.appArgs></exec.appArgs>
            <exec.mainClass>com.ies21.gestionproductos.GestionProductos</exec.mainClass>
            <exec.executable>${java.home}/bin/java</exec.executable>
            <exec.workingdir>${project.basedir}</exec.workingdir>
        </properties>
    </action>
</actions>
